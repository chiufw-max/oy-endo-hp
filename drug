function getBasicData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. 刪除或註解掉原本抓取「廠商清單」的那行，因為該工作表已不存在
  // const vendorData = ss.getSheetByName('廠商清單').getDataRange().getValues(); 
  
  const drugData = ss.getSheetByName('藥品清單').getDataRange().getValues();
  
  const drugs = drugData.slice(1).map(row => ({
    code: row[2].toString(),
    name: row[4],
    vendor: row[6],
    price: parseFloat(row[7]) || 0 
  }));
  
  // === 修改重點 ===
  // 直接掃描「藥品清單」裡所有的廠商欄位 (row[4])
  // 使用 Set 自動去除重複的廠商名
  const vendors = [...new Set(drugData.slice(1).map(row => row[6]))]
                  .filter(v => v && v.toString().trim() !== ""); // 過濾掉空白
  
  // 依筆畫或字母排序，讓下拉選單好找一點
  vendors.sort((a, b) => a.localeCompare(b));
  
  return { vendors: vendors, drugs: drugs, nextSerial: generateNextSerial(ss) };
}

function generateNextSerial(ss) {
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const lastRow = masterSheet.getLastRow();
  const todayStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd');
  
  let newSeq = 1;
  
  if (lastRow > 1) {
    const lastSerial = masterSheet.getRange(lastRow, 1).getValue().toString();
    if (lastSerial.startsWith(todayStr)) {
      const parts = lastSerial.split('-');
      if (parts.length > 1) {
        newSeq = parseInt(parts[1]) + 1;
      }
    }
  }
  return todayStr + "-" + newSeq.toString().padStart(3, '0');
}

// V6.1: 依日期取得單號
function getSerialByDate(dateStr) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  
  if (!dateStr) dateStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  const cleanDateStr = dateStr.replace(/-/g, '');
  const prefix = cleanDateStr + "-";
  
  let maxSeq = 0;
  const lastRow = masterSheet.getLastRow();

  if (lastRow > 1) {
    const data = masterSheet.getRange(2, 1, lastRow - 1, 1).getValues();
    for (let i = 0; i < data.length; i++) {
      const serial = data[i][0].toString();
      if (serial.startsWith(prefix)) {
        const parts = serial.split('-');
        if (parts.length > 1) {
          const seq = parseInt(parts[1], 10);
          if (seq > maxSeq) maxSeq = seq;
        }
      }
    }
  }
  
  const nextSeq = maxSeq + 1;
  return prefix + nextSeq.toString().padStart(3, '0');
}

function saveInboundForm(formObj) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const detailSheet = ss.getSheetByName('入庫單_明細');
  
  const finalSerial = formObj.manualSerial;
  const entryDate = new Date(formObj.date);
  
  // === 修改開始：支援自訂日期 ===
  let payDate;
  // 如果使用者選了自訂，且有傳入日期，就直接用該日期
  if (formObj.paymentTerm === 'custom' && formObj.customPayDate) {
    payDate = new Date(formObj.customPayDate);
  } else {
    // 原本的邏輯：自動推算
    payDate = new Date(entryDate);
    if (formObj.paymentTerm === '1month') {
      payDate.setMonth(payDate.getMonth() + 1);
    } else if (formObj.paymentTerm === '3months') {
      payDate.setMonth(payDate.getMonth() + 3);
    }
    // 預設 fallback (如果都沒選到，就預設 +1)
    else {
      payDate.setMonth(payDate.getMonth() + 1);
    }
  }
  // === 修改結束 ===
  const payDateStr = Utilities.formatDate(payDate, Session.getScriptTimeZone(), 'yyyy/MM/dd');

  masterSheet.appendRow([
    finalSerial, formObj.date, formObj.mainVendor,
    formObj.totalAmount, formObj.discountAmount, payDateStr, "正常"
  ]);

  const details = JSON.parse(formObj.itemsJson);
  const detailRows = details.map(item => [
    finalSerial, item.code, item.name, item.qty, item.price, item.subtotal,
    "未銷帳", "", ""
  ]);
  
  if (detailRows.length > 0) {
    detailSheet.getRange(detailSheet.getLastRow() + 1, 1, detailRows.length, 9).setValues(detailRows);
  }

  const nextSerialForSameDate = getSerialByDate(formObj.date);

  return { 
    success: true, 
    msg: "單號 " + finalSerial + " 入庫成功", 
    nextSerial: nextSerialForSameDate 
  };
}

function searchInboundDetails(criteria) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const detailSheet = ss.getSheetByName('入庫單_明細');
  
  const mData = masterSheet.getDataRange().getValues();
  const dData = detailSheet.getDataRange().getValues();
  
  const masterMap = {};
  for (let i = 1; i < mData.length; i++) {
    const row = mData[i];
    masterMap[row[0]] = {
      date: new Date(row[1]),
      vendor: row[2],
      discTotal: row[4],
      payDate: new Date(row[5]),
      mStatus: row[6]
    };
  }

  const serialItemCount = {};
  for (let i = 1; i < dData.length; i++) {
    const s = dData[i][0];
    serialItemCount[s] = (serialItemCount[s] || 0) + 1;
  }

  const result = [];
  
  for (let i = 1; i < dData.length; i++) {
    const row = dData[i];
    const serial = row[0];
    const mInfo = masterMap[serial];
    
    if (!mInfo) continue;

    const rowStatus = row[6] || "未銷帳";
    const payMethod = row[7] || "";
    const payNote = row[8] || "";
    
    if (criteria.status === 'unpaid' && (rowStatus.includes('已') || rowStatus === '作廢')) continue;
    if (criteria.status === 'paid' && !rowStatus.includes('已')) continue;
    if (criteria.status === 'void' && rowStatus !== '作廢') continue;

    // === 判斷入庫區間 ===
    const inboundStr = Utilities.formatDate(mInfo.date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
    if (criteria.inboundStart && inboundStr < criteria.inboundStart) continue;
    if (criteria.inboundEnd && inboundStr > criteria.inboundEnd) continue;
    
    // === 判斷廠商 (若留空白則跳過判斷，搜尋全部) ===
    if (criteria.vendor && mInfo.vendor !== criteria.vendor) continue;
    
    // === 判斷預計銷帳區間 ===
    const payStr = Utilities.formatDate(mInfo.payDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
    if (criteria.payStart && payStr < criteria.payStart) continue;
    if (criteria.payEnd && payStr > criteria.payEnd) continue;
    
    result.push({
      rowIndex: i + 1,
      serial: serial,
      inboundDate: Utilities.formatDate(mInfo.date, Session.getScriptTimeZone(), 'yyyy/MM/dd'),
      payDate: Utilities.formatDate(mInfo.payDate, Session.getScriptTimeZone(), 'yyyy/MM/dd'),
      vendor: mInfo.vendor,
      code: row[1],
      drugName: row[2],
      qty: row[3],
      price: row[4],
      subtotal: row[5],
      status: rowStatus,
      payMethod: payMethod,
      payNote: payNote,
      masterDiscTotal: mInfo.discTotal,
      totalItemsInOrder: serialItemCount[serial]
    });
  }
  
  result.sort((a, b) => a.serial.localeCompare(b.serial));
  
  return result;
}

function updatePaymentStatus(rowIndices, type, dateStr) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const detailSheet = ss.getSheetByName('入庫單_明細');
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  
  const serialsToRevert = new Set();

  rowIndices.forEach(idx => {
    const serial = detailSheet.getRange(idx, 1).getValue(); 
    const range = detailSheet.getRange(idx, 7, 1, 3);
    
    if (type === 'transfer') {
      range.setValues([["已轉帳", "轉帳", "轉帳日:" + dateStr]]);
    } else if (type === 'cash_prep') {
      range.setValues([["備款完成", "現金", "備款日:" + dateStr]]);
    } else if (type === 'cash_done') {
      range.setValues([["已取款", "現金", "取款日:" + dateStr]]);
    } else if (type === 'revert') {
      range.setValues([["未銷帳", "", ""]]);
      serialsToRevert.add(serial);
    }
  });

  if (type === 'revert' && serialsToRevert.size > 0) {
    const mData = masterSheet.getDataRange().getValues();
    serialsToRevert.forEach(targetSerial => {
      for (let i = 1; i < mData.length; i++) {
        if (mData[i][0].toString() === targetSerial.toString() && mData[i][6] === '作廢') {
          masterSheet.getRange(i + 1, 7).setValue("正常");
        }
      }
    });
  }
  
  return "狀態更新成功！";
}

function voidInboundOrder(serial) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const detailSheet = ss.getSheetByName('入庫單_明細');
  
  const mData = masterSheet.getDataRange().getValues();
  for (let i = 1; i < mData.length; i++) {
    if (mData[i][0].toString() === serial.toString()) {
      masterSheet.getRange(i + 1, 7).setValue("作廢");
      break;
    }
  }

  const dData = detailSheet.getDataRange().getValues();
  for (let i = 1; i < dData.length; i++) {
    if (dData[i][0].toString() === serial.toString()) {
      detailSheet.getRange(i + 1, 7).setValue("作廢");
    }
  }
  
  return "單號 " + serial + " 已作廢。";
}

function adminDeleteDataByDate(password, targetDateStr) {
  if (password !== '8888') {
    return "密碼錯誤，拒絕存取。";
  }
  
  if (!targetDateStr || targetDateStr.length !== 8) {
    return "日期格式錯誤";
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const detailSheet = ss.getSheetByName('入庫單_明細');
  
  const searchPrefix = targetDateStr + "-";
  let deletedCount = 0;

  const lastDetailRow = detailSheet.getLastRow();
  if (lastDetailRow > 1) {
    const detailData = detailSheet.getRange(2, 1, lastDetailRow - 1, 1).getValues();
    for (let i = detailData.length - 1; i >= 0; i--) {
      const serial = detailData[i][0].toString();
      if (serial.startsWith(searchPrefix)) {
        detailSheet.deleteRow(i + 2);
      }
    }
  }

  const lastMasterRow = masterSheet.getLastRow();
  if (lastMasterRow > 1) {
    const masterData = masterSheet.getRange(2, 1, lastMasterRow - 1, 1).getValues();
    for (let i = masterData.length - 1; i >= 0; i--) {
      const serial = masterData[i][0].toString();
      if (serial.startsWith(searchPrefix)) {
        masterSheet.deleteRow(i + 2);
        deletedCount++;
      }
    }
  }

  const todayStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd');
  let nextSerial = null;
  if (targetDateStr === todayStr) {
     nextSerial = generateNextSerial(ss);
  }

  return {
    msg: `已刪除日期 [${targetDateStr}] 的資料，共 ${deletedCount} 筆主單。`,
    nextSerial: nextSerial 
  };
}

// 新增功能：修改入庫單的「折後總額」
// ==========================================
function updateOrderDiscount(serial, newAmount) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const data = masterSheet.getDataRange().getValues();

  // 遍歷主檔尋找單號
  // 資料結構參照 saveInboundForm: 
  // [0]單號, [1]日期, [2]廠商, [3]總額, [4]折後金額, [5]付款日, [6]狀態
  for (let i = 1; i < data.length; i++) {
    if (data[i][0].toString() === serial.toString()) {
      // 找到該列 (Row index 從 1 開始，所以是 i+1)
      // 修改第 5 欄 (Column E) = 折後金額
      masterSheet.getRange(i + 1, 5).setValue(newAmount);
      return "單號 " + serial + " 的折後金額已更新為：" + newAmount;
    }
  }
  return "找不到單號 " + serial;
}

// 8. 統計報表功能 (V7.0 更新：支援明細紀錄與數量排序)
function getStatisticsReport(criteria) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const detailSheet = ss.getSheetByName('入庫單_明細');
  
  const mData = masterSheet.getDataRange().getValues();
  const dData = detailSheet.getDataRange().getValues();
  
  const masterMap = {};
  for (let i = 1; i < mData.length; i++) {
    const row = mData[i];
    if (row[6] === '作廢') continue;
    
    const dStr = Utilities.formatDate(new Date(row[1]), Session.getScriptTimeZone(), 'yyyy-MM-dd');
    masterMap[row[0]] = {
      dateStr: dStr,
      vendor: row[2]
    };
  }

  const stats = {};

  for (let i = 1; i < dData.length; i++) {
    const row = dData[i];
    const serial = row[0];
    const mInfo = masterMap[serial];
    
    if (!mInfo) continue;
    if (row[6] === '作廢') continue;

    if (criteria.startDate && mInfo.dateStr < criteria.startDate) continue;
    if (criteria.endDate && mInfo.dateStr > criteria.endDate) continue;
    if (criteria.vendor && mInfo.vendor !== criteria.vendor) continue;
    const code = row[1].toString(); // 確保代碼是字串

    // === 新增邏輯：如果是耗材群組模式，只允許 ZZ 開頭的代碼 ===
    if (criteria.isConsumablesGroup) {
      if (!code.toUpperCase().startsWith('ZZ')) continue;
    } 
    // === 原有邏輯：如果有指定單一藥品 (且未勾選耗材群組)，則篩選單一藥品 ===
    else if (criteria.drugCode && code !== criteria.drugCode.toString()) {
      continue;
    }

    const qty = parseFloat(row[3]) || 0;
    const subtotal = parseFloat(row[5]) || 0;
    const price = parseFloat(row[4]) || 0;

    if (!stats[code]) {
      stats[code] = {
        code: code,
        name: row[2],
        vendor: mInfo.vendor,
        qty: 0,
        subtotal: 0,
        details: [] // V7.0 新增：詳細記錄
      };
    }
    
    stats[code].qty += qty;
    stats[code].subtotal += subtotal;
    
    // 加入明細 (用於前端展開)
    stats[code].details.push({
      date: mInfo.dateStr,
      serial: serial,
      qty: qty,
      price: price,
      subtotal: subtotal
    });
  }

  const result = Object.values(stats).map(item => ({
    code: item.code,
    name: item.name,
    vendor: item.vendor,
    qty: item.qty,
    subtotal: item.subtotal,
    avgPrice: (item.qty > 0) ? Math.round(item.subtotal / item.qty) : 0,
    details: item.details
  }));

  // V7.0 需求 7: 依總數量由多到少排列
  // 判斷：如果是「耗材群組」模式，依廠商名稱排序 (筆畫多 -> 少)
  if (criteria.isConsumablesGroup) {
    result.sort((a, b) => {
      // localeCompare: 比較字串
      // b 對 a (b.localeCompare(a)) = 降冪 (筆畫多到少)
      // a 對 b (a.localeCompare(b)) = 升冪 (筆畫少到多)
      return b.vendor.localeCompare(a.vendor, 'zh-TW');
    });
  } else {
    // 預設模式 (一般藥品統計)：依「總數量」由多到少排列
    result.sort((a, b) => b.qty - a.qty);
  }

  return result;
}

// === 新增：檢查本日是否重複入庫 ===
function checkDuplicateInbound(dateStr, codes) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = ss.getSheetByName('入庫單_主檔');
  const detailSheet = ss.getSheetByName('入庫單_明細');

  const mData = masterSheet.getDataRange().getValues();
  const dData = detailSheet.getDataRange().getValues();

  // 1. 找出同一天的所有單號
  const targetSerials = new Set();
  for (let i = 1; i < mData.length; i++) {
    if (mData[i][6] === '作廢') continue; // 略過已作廢
    const rowDate = Utilities.formatDate(new Date(mData[i][1]), Session.getScriptTimeZone(), 'yyyy-MM-dd');
    if (rowDate === dateStr) {
      targetSerials.add(mData[i][0].toString());
    }
  }

  // 2. 檢查明細中是否有相同的藥品代碼
  const duplicates = new Set();
  for (let i = 1; i < dData.length; i++) {
    const serial = dData[i][0].toString();
    if (targetSerials.has(serial) && dData[i][6] !== '作廢') {
      const code = dData[i][1].toString();
      if (codes.includes(code)) {
        duplicates.add(dData[i][2]); // 記錄重複的藥名
      }
    }
  }
  return Array.from(duplicates);
}

