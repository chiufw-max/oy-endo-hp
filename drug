    .vendor-text { font-size: 1.4rem; color: var(--primary); }
    
    input[type="checkbox"] { transform: scale(1.8); cursor: pointer; margin-right: 5px; width: auto;}
    tbody.group-odd td { background: #fff; }
    tbody.group-even td { background: #e0f2f1; } 
    
    .detail-row { display: none; background-color: #f3e5f5; }
    .detail-table { width: 90%; margin: 10px auto; border: 1px solid #ddd; border-radius: 8px; font-size: 1.1rem; }
    .detail-table th { background: #9c27b0; font-size: 1.1rem; padding: 10px; }
    .detail-table td { background: #fff; font-size: 1.1rem; padding: 10px; border-bottom: 1px solid #eee; }
    
    .expand-btn { cursor: pointer; user-select: none; font-size: 1.2rem; }
    .expand-multiple { color: #d32f2f; font-weight: bold; }
    .expand-single { color: #9e9e9e; }

    .status-tag { padding: 8px 15px; border-radius: 15px; font-size: 1rem; font-weight: bold; }
    .st-unpaid { color: #d32f2f; background: #ffebee; }
    .st-prep { color: #f57c00; background: #fff3e0; }
    .st-done { color: #388e3c; background: #e8f5e9; }
    .st-void { color: #9e9e9e; text-decoration: line-through; } 

    .tabs { display: flex; gap: 15px; margin-bottom: 20px; flex-wrap: wrap; }
    .tab-btn { background: #cfd8dc; color: #546e7a; border-radius: 20px; padding: 15px 40px; border:none; cursor:pointer; font-size: 1.25rem; }
    .tab-btn.active { background: var(--primary); color: white; box-shadow: 0 4px 10px rgba(0,137,123,0.3); }

    .payment-console { background: #e3f2fd; padding: 25px; border-radius: 12px; border: 1px solid #bbdefb; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    
    .admin-btn {
      position: fixed; bottom: 20px; right: 20px; width: 60px; height: 60px;
      background: #455a64; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 1.8rem; box-shadow: 0 4px 10px rgba(0,0,0,0.3); cursor: pointer; z-index: 9999; transition: transform 0.3s;
    }
    .admin-btn:hover { transform: rotate(90deg) scale(1.1); background: #263238; }
  </style>
</head>
<body>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('inbound', this)">入庫作業</button>
    <button class="tab-btn" onclick="switchTab('query', this)">查詢與銷帳</button>
    <button class="tab-btn" onclick="switchTab('stats', this)">📊 統計報表</button>
    <button class="tab-btn btn-link" onclick="window.open('https://script.google.com/macros/s/AKfycbxHVNjSKE7MvOeuwOB-QKay_h3qb_mh1ESkrJqqSnIidA6TpYIahzwVTKVivbYZ_O9E/exec', '_blank')" style="color:white; margin-left:auto;">💊 診所藥品分析</button>
  </div>

  <div id="inboundSection" class="section">
    <h2>入庫作業</h2>
    <div class="row" style="background:#e8f0fe; padding:25px; border-radius:12px;">
      <div class="control-group"><label>日期</label><input type="date" id="entryDate" onchange="updateSerial()"></div>
      <div class="control-group"><label>單號</label><input type="text" id="manualSerial" style="width:180px; font-weight:bold; color:var(--primary);"></div>
      
      <div class="control-group vendor-input-group">
        <label>廠商 (模糊搜尋)</label>
        <input type="text" id="mainVendorInput" list="vendorList" placeholder="選廠商..." onchange="onMainVendorChange()">
        <datalist id="vendorList"></datalist>
      </div>
      
      <div class="control-group">
        <label>條件</label>
        <select id="paymentTerm" onchange="toggleCustomDate()">
          <option value="1month">月結 +1</option>
          <option value="3months">月結 +3</option>
          <option value="custom" style="color:blue; font-weight:bold;">自訂付款日</option>
        </select>
        <input type="date" id="customPayDate" style="display:none; margin-top:5px; border:2px solid var(--info); color:var(--info); font-weight:bold;" title="請選擇預計付款日">
      </div>
    </div>
    
    <div class="inbound-header">
      <div class="w-code">代碼</div>
      <div class="w-drug">藥名</div>
      <div class="w-qty">數量</div>
      <div class="w-price">單價</div>
      <div class="w-sub">小計</div>
      <div class="w-btn" style="text-align:center;">操作</div>
    </div>
    
    <div id="itemsContainer"></div>
    
    <div class="row" style="margin-top:25px;">
        <button onclick="addItemRow()" style="font-size:1.2rem;">+ 增加欄位</button>
        <div style="flex-grow:1;"></div>
        <button class="btn-orange" onclick="resetForm(true)">全表清空</button>
    </div>
    
    <div class="row" style="justify-content:flex-end; border-top:2px dashed #ccc; padding-top:25px; margin-top:25px;">
      <h3 style="margin-right:25px; font-size:1.5rem;">試算: <span id="calcTotal">0</span></h3>
      <div class="control-group"><label style="color:red;">折後總額</label><input type="number" id="discountAmount" style="border:2px solid red; color:red; font-weight:bold; font-size:1.4rem; width: 180px;"></div>
      <button onclick="submitInbound()" style="margin-left:25px; padding:12px 50px; font-size:1.3rem;">確認入庫</button>
    </div>
  </div>

  <div id="querySection" class="section" style="display:none;">
    <h2>查詢與銷帳</h2>
    
    <div class="row" style="background:#fff3e0; padding:25px; border-radius:12px;">
      <div class="control-group"><label>顯示狀態</label>
        <select id="qStatus">
          <option value="unpaid">未結案 (未銷/備款)</option>
          <option value="paid">已結案 (轉帳/取款)</option>
          <option value="void">已作廢</option>
          <option value="all">全部</option>
        </select>
      </div>
      <div class="control-group vendor-input-group"><label>廠商</label><input type="text" id="qVendor" list="vendorList" placeholder="廠商..."></div>
      
      <div class="control-group">
        <label>入庫區間</label>
        <div style="display:flex; gap:5px; align-items:center;">
          <input type="date" id="qInboundStart" style="width:200px;">
          <span style="font-weight:bold; color:#666; font-size:1.5rem;">~</span>
          <input type="date" id="qInboundEnd" style="width:200px;">
        </div>
      </div>
      
      <div class="control-group">
        <label>預計銷帳區間</label>
        <div style="display:flex; gap:5px; align-items:center;">
          <input type="date" id="qPayStart" style="width:200px;">
          <span style="font-weight:bold; color:#666; font-size:1.5rem;">~</span>
          <input type="date" id="qPayEnd" style="width:200px;">
        </div>
      </div>
      
      <button onclick="runQuery()" style="margin-top:28px; padding:12px 20px;">🔍 查詢</button>
      <button onclick="exportToExcel()" class="btn-success" style="margin-top:28px; margin-left:5px; padding:12px 20px;" title="匯出 Excel">📥</button>
    </div>

    <div id="queryResults"></div>

    <div class="payment-console" style="margin-top:25px;">
      <div style="font-weight:bold; color:#1565c0; font-size:1.3rem;">💰 銷帳/操作控制台</div>
      <div class="control-group"><label>操作日期</label><input type="date" id="actionDate"></div>
      <div class="control-group"><label>執行動作</label>
        <select id="actionType" style="border:2px solid #1565c0; color:#0d47a1; font-weight:bold;">
          <option value="transfer">🏦 轉帳 (直接結案)</option>
          <option value="cash_prep">✉️ 現金-已備款 (放入櫃台)</option>
          <option value="cash_done">🤝 現金-已取款 (廠商拿走)</option>
          <option value="revert" style="color:red;">↩️ 救回 (取消作廢/還原未銷)</option>
        </select>
      </div>
      <div style="flex-grow:1; text-align:right;">
        <div style="font-size:1.2rem;">選取金額: <span id="selectedTotal" style="color:blue; font-size:1.8rem; font-weight:bold;">0</span></div>
      </div>
      <button onclick="executePayment()" class="btn-info" style="padding:15px 50px; font-size:1.2rem;">確認執行</button>
    </div>
  </div>

  <div id="statsSection" class="section" style="display:none;">
    <h2 style="color:var(--purple); border-color:var(--purple);">統計報表</h2>
    
    <div class="row" style="background:#f3e5f5; padding:25px; border-radius:12px;">
      <div class="control-group"><label>開始日期</label><input type="date" id="statStartDate"></div>
      <div class="control-group"><label>結束日期</label><input type="date" id="statEndDate"></div>
      
      <div class="control-group vendor-input-group"><label>指定廠商</label>
        <input type="text" id="statVendor" list="vendorList" placeholder="廠商..." onchange="updateStatDrugList()">
      </div>
      
      <div class="control-group" style="flex: 0 0 250px; max-width: 250px;">
        <label>指定藥品</label>
        <input type="text" id="statDrug" list="statDrugDatalist" placeholder="選填..." onchange="onStatDrugChange()">
        <datalist id="statDrugDatalist"></datalist>
      </div>

      <div class="control-group" style="justify-content:center;">
        <label style="cursor:pointer; color:#d81b60; font-weight:bold; margin-top:25px;">
           <input type="checkbox" id="statGroupZZ" onchange="toggleStatInputs()"> 
           📦 統計耗材群組 (ZZ系列)
        </label>
      </div>

      <button onclick="runStats()" class="btn-purple" style="margin-top:28px;">📊 開始統計</button>
      <button onclick="exportStatsToExcel()" class="btn-success" style="margin-top:28px;">📥 匯出 Excel</button>
      <button onclick="clearStatsForm()" class="btn-orange" style="margin-top:28px;">清空條件</button>
    </div>

    <div id="statsResults">
       <p style="text-align:center; color:#888; padding:25px;">請選擇條件並點擊「開始統計」</p>
    </div>
  </div>

  <div class="admin-btn" onclick="runAdminTask()" title="管理員功能：抹除資料">⚙️</div>
  <datalist id="drugCodeList"></datalist>

  <script>
    let globalDrugs = [];
    let globalVendors = [];
    let currentQueryData = [];
    let currentStatsData = [];

    document.addEventListener('keydown', function(event) {
      if (event.key === "Escape") {
        const activeElement = document.activeElement;
        if (activeElement && (activeElement.tagName === "INPUT" || activeElement.tagName === "SELECT")) {
          activeElement.value = "";
          if (activeElement.id === 'mainVendorInput') onMainVendorChange();
          if (activeElement.id === 'statVendor') updateStatDrugList();
        }
      }
    });

    window.onload = function() {
      const today = new Date();
      const firstDay = new Date(today.getFullYear(), today.getMonth(), 1); 
      
      document.getElementById('entryDate').valueAsDate = today;
      document.getElementById('actionDate').valueAsDate = today; 
      
      document.getElementById('statStartDate').valueAsDate = firstDay;
      document.getElementById('statEndDate').valueAsDate = today;

      google.script.run.withSuccessHandler(initData).getBasicData();
    };
    
    function toggleCustomDate() {
      const term = document.getElementById('paymentTerm').value;
      const customInput = document.getElementById('customPayDate');
      
      if (term === 'custom') {
        customInput.style.display = 'block';
        if(!customInput.value) {
           customInput.value = document.getElementById('entryDate').value;
        }
      } else {
        customInput.style.display = 'none';
        customInput.value = '';
      }
    }

    function initData(data) {
      globalDrugs = data.drugs;
      globalVendors = data.vendors;
      document.getElementById('manualSerial').value = data.nextSerial;
      const vList = document.getElementById('vendorList');
      vList.innerHTML = '';
      globalVendors.forEach(v => {
        let opt = document.createElement('option'); opt.value = v; vList.appendChild(opt);
      });
      addItemRow();
      updateStatDrugList(); // === 新增這行：網頁載入時，先載入所有藥品清單 ===
    }

    function updateSerial() {
      const dateStr = document.getElementById('entryDate').value;
      if (!dateStr) return;
      const serialInput = document.getElementById('manualSerial');
      serialInput.value = "更新中...";
      serialInput.style.color = "#999";
      google.script.run.withSuccessHandler(function(newSerial) {
        serialInput.value = newSerial;
        serialInput.style.color = "var(--primary)";
      }).getSerialByDate(dateStr);
    }

    function switchTab(tabName, btnElement) {
      const sections = ['inboundSection', 'querySection', 'statsSection'];
      sections.forEach(id => {
        const el = document.getElementById(id);
        if(el) el.style.display = 'none';
      });
      const target = document.getElementById(tabName + 'Section');
      if(target) target.style.display = 'block';
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      if(btnElement && !btnElement.classList.contains('btn-link')) btnElement.classList.add('active');
    }

    // --- 統計相關 ---
    function updateStatDrugList() {
      const v = document.getElementById('statVendor').value;
      const dl = document.getElementById('statDrugDatalist'); dl.innerHTML = '';
      let list = v ? globalDrugs.filter(d => d.vendor === v) : globalDrugs;
      list.sort((a, b) => a.name.localeCompare(b.name));
      list.forEach(d => { let opt=document.createElement('option'); opt.value=d.code; opt.label=d.name; dl.appendChild(opt); });
    }

    // === 新增：選定藥品後，自動帶入廠商 ===
    function onStatDrugChange() {
      const code = document.getElementById('statDrug').value;
      if (code) {
        const drug = globalDrugs.find(d => d.code === code);
        if (drug) {
           // 自動把廠商填入
           document.getElementById('statVendor').value = drug.vendor;
           // 更新藥品清單（縮小範圍為該廠商）
           updateStatDrugList();
        }
      }
    }

    function clearStatsForm() {
      const today = new Date();
      const firstDay = new Date(today.getFullYear(), today.getMonth(), 1); 
      document.getElementById('statStartDate').valueAsDate = firstDay;
      document.getElementById('statEndDate').valueAsDate = today;
      document.getElementById('statVendor').value = '';
      document.getElementById('statDrug').value = '';
      document.getElementById('statsResults').innerHTML = '<p style="text-align:center; color:#888; padding:25px;">條件已清空</p>';
    }

    function runStats() {
      const criteria = {
        startDate: document.getElementById('statStartDate').value,
        endDate: document.getElementById('statEndDate').value,
        vendor: document.getElementById('statVendor').value,
        drugCode: document.getElementById('statDrug').value
      };
      if(!criteria.startDate || !criteria.endDate) { alert("請選擇完整的日期區間"); return; }
      document.getElementById('statsResults').innerHTML = '<p align="center">統計運算中...</p>';
      google.script.run.withSuccessHandler(renderStatsTable).getStatisticsReport(criteria);
    }

    function renderStatsTable(data) {
      currentStatsData = data;
      const div = document.getElementById('statsResults'); div.innerHTML = '';
      if(data.length === 0) { div.innerHTML = '<p align="center" style="padding:25px;">無符合資料</p>'; return; }

      let grandTotalQty = 0; let grandTotalAmt = 0;
      let html = `<table style="border: 2px solid #7b1fa2;">
        <thead><tr style="background:#ba68c8; color:white;">
          <th width="50"></th><th>廠商</th><th>藥品名稱</th><th>院內碼</th><th>總數量</th><th>平均單價</th><th>總金額</th>
        </tr></thead><tbody>`;
      
      data.forEach((row, idx) => {
        const bg = idx % 2 === 0 ? '#fff' : '#f3e5f5';
        grandTotalQty += row.qty; grandTotalAmt += row.subtotal;
        
        const count = row.details.length;
        const expandClass = count > 1 ? 'expand-multiple' : 'expand-single';
        const expandText = count > 1 ? `+ (${count})` : `+ (1)`;
        
        html += `<tr style="background:${bg};">
          <td onclick="toggleDetail('${row.code}')" class="expand-btn ${expandClass}" title="展開明細">${expandText}</td>
          <td style="color:#7b1fa2; font-weight:bold;">${row.vendor}</td>
          <td>${row.name}</td>
          <td>${row.code}</td>
          <td style="font-weight:bold;">${row.qty}</td>
          <td>${row.avgPrice}</td>
          <td style="color:#d81b60; font-weight:bold;">${row.subtotal.toLocaleString()}</td>
        </tr>`;
        
        let detailHtml = `<table class="detail-table"><thead><tr><th>入庫日期</th><th>單號</th><th>數量</th><th>單價</th><th>小計</th></tr></thead><tbody>`;
        row.details.forEach(d => {
          detailHtml += `<tr><td>${d.date}</td><td>${d.serial}</td><td>${d.qty}</td><td>${d.price}</td><td>${d.subtotal.toLocaleString()}</td></tr>`;
        });
        detailHtml += `</tbody></table>`;

        html += `<tr id="detail-${row.code}" class="detail-row"><td colspan="7" style="padding:15px;">${detailHtml}</td></tr>`;
      });
      
      html += `<tr style="background:#4a148c; color:white; font-weight:bold; font-size:1.4rem;"><td colspan="4" style="text-align:right;">總計：</td><td>${grandTotalQty}</td><td>-</td><td>${grandTotalAmt.toLocaleString()}</td></tr></tbody></table>`;
      div.innerHTML = html;
    }

    function toggleDetail(code) {
      const row = document.getElementById('detail-' + code);
      if(row.style.display === 'table-row') {
        row.style.display = 'none';
      } else {
        row.style.display = 'table-row';
      }
    }

    function exportStatsToExcel() {
      if(!currentStatsData || currentStatsData.length === 0) { alert("無報表資料可匯出"); return; }
      const exportData = currentStatsData.map(row => ({ "廠商": row.vendor, "藥品名稱": row.name, "院內碼": row.code, "總進貨數量": row.qty, "平均單價": row.avgPrice, "總進貨金額": row.subtotal }));
      const worksheet = XLSX.utils.json_to_sheet(exportData);
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, "統計報表");
      const start = document.getElementById('statStartDate').value;
      const end = document.getElementById('statEndDate').value;
      XLSX.writeFile(workbook, `藥庫統計報表_${start}_${end}.xlsx`);
    }

    // --- (原有功能) ---
    function exportToExcel() {
      if (!currentQueryData || currentQueryData.length === 0) { alert("無查詢結果"); return; }
      const exportData = currentQueryData.map(row => ({ "單號": row.serial, "廠商": row.vendor, "入庫日期": row.inboundDate, "預計銷帳日": row.payDate, "藥品名稱": row.drugName, "院內碼": row.code, "數量": row.qty||0, "單價": row.price||0, "小計": row.subtotal, "狀態": row.status, "付款歷程": row.payNote }));
      const worksheet = XLSX.utils.json_to_sheet(exportData);
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, "查詢結果");
      const todayStr = new Date().toISOString().split('T')[0];
      XLSX.writeFile(workbook, `藥庫查詢結果_${todayStr}.xlsx`);
    }

    function onMainVendorChange() {
      const mainV = document.getElementById('mainVendorInput').value;
      updateCodeDatalist(mainV);
      document.querySelectorAll('.ib-container').forEach(row => {
        const code = row.querySelector('.code-input').value;
        if(code) {
           const d = globalDrugs.find(x=>x.code==code);
           if(d && mainV && d.vendor!==mainV) clearRow(row);
        }
        filterDrugsForSelect(row.querySelector('.drug-select'), mainV);
      });
    }

    function updateCodeDatalist(vendor) {
      const dl = document.getElementById('drugCodeList'); dl.innerHTML = '';
      let list = vendor ? globalDrugs.filter(d=>d.vendor===vendor) : globalDrugs;
      list.sort((a, b) => a.name.localeCompare(b.name));
      list.forEach(d => { let opt=document.createElement('option'); opt.value=d.code; opt.label=d.name; dl.appendChild(opt); });
    }

    // --- 核心修改：使用 inline-block 生成表格 ---
    function addItemRow() {
      const div = document.createElement('div'); 
      div.className = 'ib-container'; // 使用新定義的容器類別
      
      div.innerHTML = `
        <div class="ib-item w-code">
            <input type="text" class="code-input" list="drugCodeList" onchange="onCodeInput(this)" placeholder="代碼">
        </div>
        
        <div class="ib-item w-drug">
             <div class="drug-wrap">
                 <select class="drug-select" onchange="onDrugSelect(this)" disabled>
                    <option value="">(先選廠商)</option>
                 </select>
             </div>
        </div>

        <div class="ib-item w-qty">
            <input type="number" class="qty" oninput="calcRow(this)" placeholder="數量">
        </div>

        <div class="ib-item w-price">
            <input type="number" class="price" readonly>
        </div>
        
        <div class="ib-item w-sub">
            <span class="subtotal" style="display:block; text-align:right;">0</span>
        </div>
        
        <div class="ib-item w-btn">
            <div style="text-align:center;">
                <button class="btn-orange btn-small" onclick="clearRow(this.closest('.ib-container'))">清</button>
                <button class="btn-red btn-small" onclick="removeRow(this)">刪</button>
            </div>
        </div>
      `;
      document.getElementById('itemsContainer').appendChild(div);
      const mainV = document.getElementById('mainVendorInput').value;
      if(mainV) filterDrugsForSelect(div.querySelector('.drug-select'), mainV);
    }
    
    function filterDrugsForSelect(sel, vendor) {
      if(!vendor) { sel.innerHTML='<option value="">(先選廠商)</option>'; sel.disabled=true; return; }
      sel.disabled=false;
      const list = globalDrugs.filter(d=>d.vendor===vendor);
      if(list.length===0) { sel.innerHTML='<option>(無資料)</option>'; return; }
      
      list.sort((a, b) => a.name.localeCompare(b.name));

      const curr = sel.value;
      sel.innerHTML = '<option value="">請選擇...</option>' + list.map(d=>`<option value="${d.code}">${d.name}</option>`).join('');
      if(curr && list.find(d=>d.code==curr)) sel.value=curr;
    }

    function onCodeInput(inp) {
      const code = inp.value; const drug = globalDrugs.find(d=>d.code==code);
      if(!drug) return;
      const mainV = document.getElementById('mainVendorInput');
      if(!mainV.value) { mainV.value = drug.vendor; onMainVendorChange(); }
      else if(mainV.value !== drug.vendor) { alert("廠商不符"); inp.value=""; return; }
      
      const row = inp.closest('.ib-container');
      row.querySelector('.drug-select').value = drug.code;
      row.querySelector('.price').value = drug.price;
      calcRow(inp);
    }
    
    function onDrugSelect(sel) {
      const row=sel.closest('.ib-container'); 
      if(sel.value) { 
        row.querySelector('.code-input').value=sel.value; 
        const d=globalDrugs.find(x=>x.code==sel.value); 
        row.querySelector('.price').value=d.price; 
        calcRow(sel); 
      } else clearRow(row);
    }
    
    function calcRow(el) {
      const row=el.closest('.ib-container'); 
      const q=row.querySelector('.qty').value||0; 
      const p=row.querySelector('.price').value||0;
      row.querySelector('.subtotal').innerText=Math.round(q*p);
      let t=0; document.querySelectorAll('.subtotal').forEach(s=>t+=parseFloat(s.innerText));
      document.getElementById('calcTotal').innerText=t;
    }
    
    function clearRow(row) {
      row.querySelector('.code-input').value=''; row.querySelector('.drug-select').value='';
      row.querySelector('.qty').value=''; row.querySelector('.price').value=''; 
      row.querySelector('.subtotal').innerText='0';
      let t=0; document.querySelectorAll('.subtotal').forEach(s=>t+=parseFloat(s.innerText));
      document.getElementById('calcTotal').innerText=t;
    }
    
    function removeRow(btn) { 
      if(document.querySelectorAll('.ib-container').length>1) btn.closest('.ib-container').remove(); 
      else clearRow(btn.closest('.ib-container')); 
      let t=0; document.querySelectorAll('.subtotal').forEach(s=>t+=parseFloat(s.innerText));
      document.getElementById('calcTotal').innerText=t;
    }
    
    function resetForm(force) {
      if(force && !confirm("確定清空?")) return;
      document.getElementById('itemsContainer').innerHTML=''; 
      document.getElementById('mainVendorInput').value='';
      document.getElementById('calcTotal').innerText='0';
      document.getElementById('discountAmount').value='';
      addItemRow(); updateCodeDatalist('');
    }

    function submitInbound() {
       // 防呆機制：防止單號還沒出來就存檔
       const currentSerial = document.getElementById('manualSerial').value;
       if (currentSerial === "更新中...") {
           alert("⏳ 單號正在產生中，請稍等一兩秒後再按確認！");
           return; 
       }

       const v = document.getElementById('mainVendorInput').value;
       if(!v) { alert("請填廠商"); return; }
       
       const rows = document.querySelectorAll('.ib-container');
       let items = [];
       rows.forEach(r=>{
         if(r.querySelector('.drug-select').value && r.querySelector('.qty').value>0) {
           items.push({
             code: r.querySelector('.drug-select').value,
             name: r.querySelector('.drug-select').options[r.querySelector('.drug-select').selectedIndex].text,
             qty: r.querySelector('.qty').value,
             price: r.querySelector('.price').value,
             subtotal: r.querySelector('.subtotal').innerText
           });
         }
       });
       if(items.length==0) { alert("無資料"); return; }
       
       const formDate = document.getElementById('entryDate').value;
       const codes = items.map(item => item.code);

       // 讓按鈕顯示檢查中，防止連點
       const btn = document.querySelector('button[onclick="submitInbound()"]');
       btn.innerText = "檢查中...";
       btn.disabled = true;

       // 呼叫後端檢查是否重複
       google.script.run.withSuccessHandler(function(duplicates) {
          // 恢復按鈕狀態
          btn.innerText = "確認入庫";
          btn.disabled = false;

          // 若有重複，跳出警示框
          if (duplicates.length > 0) {
             const msg = "⚠️ 警示：以下品項本日已入庫過！\n\n- " + duplicates.join("\n- ") + "\n\n請問是否確定要再次入庫？";
             if (!confirm(msg)) return; // 若使用者按取消，則終止存檔
          }

          // 確認無誤，準備存檔
          const form = {
            date: formDate,
            manualSerial: document.getElementById('manualSerial').value,
            mainVendor: v,
            paymentTerm: document.getElementById('paymentTerm').value,
            customPayDate: document.getElementById('customPayDate').value,
            totalAmount: document.getElementById('calcTotal').innerText,
            discountAmount: document.getElementById('discountAmount').value || document.getElementById('calcTotal').innerText,
            itemsJson: JSON.stringify(items)
          };
          
          google.script.run.withSuccessHandler(res=>{ 
            alert(res.msg); 
            resetForm(false); 
            document.getElementById('manualSerial').value=res.nextSerial; 
          }).saveInboundForm(form);

       }).checkDuplicateInbound(formDate, codes);
    }

    function runQuery() {
      const c = {
        status: document.getElementById('qStatus').value,
        vendor: document.getElementById('qVendor').value,
        
        // 抓取新的日期區間欄位
        inboundStart: document.getElementById('qInboundStart').value,
        inboundEnd: document.getElementById('qInboundEnd').value,
        payStart: document.getElementById('qPayStart').value,
        payEnd: document.getElementById('qPayEnd').value
      };
      
      document.getElementById('queryResults').innerHTML = '<p align="center" style="font-size:1.4rem;">載入中...</p>';
      google.script.run.withSuccessHandler(renderQueryTable).searchInboundDetails(c);
      
      // 清空搜尋條件 (對應你原本加上去的功能)
      document.getElementById('qVendor').value = '';
      document.getElementById('qInboundStart').value = '';
      document.getElementById('qInboundEnd').value = '';
      document.getElementById('qPayStart').value = '';
      document.getElementById('qPayEnd').value = '';
    }

    function renderQueryTable(data) {
      currentQueryData = data;
      const div = document.getElementById('queryResults'); div.innerHTML = '';
      if(data.length===0) { div.innerHTML='<p align="center" style="padding:25px; font-size:1.4rem;">無資料</p>'; return; }

      const table = document.createElement('table');
      // 加入 <th>數量</th>
      table.innerHTML = `<thead><tr><th width="50">選</th><th>單號</th><th>藥名</th><th width="80">數量</th><th>小計</th><th>狀態</th><th>歷程</th></tr></thead>`;
      
      let currSerial = ""; let tbody = null; let gIdx = 0;
      data.forEach(row => {
        if(row.serial !== currSerial) {
          currSerial = row.serial;
          tbody = document.createElement('tbody');
          tbody.className = (gIdx++%2===0)?'group-odd':'group-even';
          
          const header = document.createElement('tr');
          const isVoid = row.status === '作廢';
          const serialStyle = isVoid ? 'text-decoration: line-through; color: #999;' : '';
          // 定義作廢按鈕
          const voidBtn = isVoid ? 
              '<span style="color:red; font-weight:bold;">[已作廢]</span>' : 
              `<button class="btn-red btn-small" onclick="voidOrder('${row.serial}')">🗑️ 作廢本單</button>`;
          
          // 定義修改金額按鈕 (只有未作廢才能修改)
          const editBtn = isVoid ? '' : 
              `<button class="btn-info btn-small" style="padding:2px 10px; margin-right:10px; font-size:1rem;" onclick="editDiscount('${row.serial}', '${row.masterDiscTotal}')">✏️ 修改</button>`;
          
          header.innerHTML = `
            <td><input type="checkbox" onchange="toggleGroup(this,'${row.serial}')"></td>
            <td class="serial-text" style="${serialStyle}">${row.serial}</td>
            <td colspan="5" style="color:var(--primary); font-size:1.3rem;">
              <strong class="vendor-text">${row.vendor}</strong> (預計銷帳: ${row.payDate})
              <span style="float:right;">
                  整單折後: <strong style="color:#d81b60; margin-right:5px;">${row.masterDiscTotal}</strong>
                  ${editBtn} | ${voidBtn}
              </span>
            </td>
          `;
          tbody.appendChild(header);
          table.appendChild(tbody);
        }
        
        let stClass = 'st-unpaid';
        if(row.status === '作廢') stClass = 'st-void';
        else if(row.status === '備款完成') stClass = 'st-prep';
        else if(row.status.includes('已')) stClass = 'st-done';

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><input type="checkbox" class="chk-item serial-${row.serial}" value="${row.rowIndex}" 
                      data-serial="${row.serial}" data-subtotal="${row.subtotal}" 
                      data-status="${row.status}" onchange="calcSel()"></td>
          <td></td>
          <td>${row.drugName}</td>
          <td style="font-weight:bold; color:#0288d1;">${row.qty}</td> <td>${row.subtotal}</td>
          <td><span class="status-tag ${stClass}">${row.status}</span></td>
          <td style="font-size:1.1rem; color:#666;">${row.payNote}</td>
        `;
        tbody.appendChild(tr);
      });
      div.appendChild(table);
      calcSel();
    }

    function toggleGroup(cb, serial) {
      document.querySelectorAll(`.serial-${serial}`).forEach(c => { c.checked=cb.checked; });
      calcSel();
    }

    function calcSel() {
      const chks = document.querySelectorAll('.chk-item:checked');
      const grp = {}; chks.forEach(c => {
        const s = c.getAttribute('data-serial');
        if(!grp[s]) grp[s]=[]; grp[s].push(parseFloat(c.getAttribute('data-subtotal')));
      });
      let total = 0;
      for(const [s, subs] of Object.entries(grp)) {
        const info = currentQueryData.find(d=>d.serial===s);
        if(info && subs.length === info.totalItemsInOrder) total += parseFloat(info.masterDiscTotal);
        else total += subs.reduce((a,b)=>a+b,0);
      }
      document.getElementById('selectedTotal').innerText = total;
    }

    function executePayment() {
      const chks = document.querySelectorAll('.chk-item:checked');
      if(chks.length===0) { alert("未勾選"); return; }
      const type = document.getElementById('actionType').value;
      const date = document.getElementById('actionDate').value;
      const amt = document.getElementById('selectedTotal').innerText;

      let hasVoid = false;
      let ids = [];
      chks.forEach(c => {
        if(c.getAttribute('data-status') === '作廢') hasVoid = true;
        ids.push(c.value);
      });

      if(type !== 'revert' && hasVoid) {
        alert("錯誤：您勾選了「已作廢」的項目！\n\n- 若要付款，請勿勾選作廢單。\n- 若要還原單據，請選擇「↩️ 救回」動作。");
        return;
      }

      let msg = "";
      if(type==='transfer') msg = `確認「轉帳」結案？\n日期: ${date}\n金額: ${amt}`;
      else if(type==='cash_prep') msg = `確認「現金-已備款」？(放入櫃台)\n日期: ${date}\n金額: ${amt}`;
      else if(type==='cash_done') msg = `確認「現金-已取款」？(廠商拿走)\n日期: ${date}\n金額: ${amt}`;
      else msg = `確認「救回」${ids.length} 筆資料？\n這將把狀態還原為「未銷帳」。`;

      if(confirm(msg)) {
        google.script.run.withSuccessHandler(res=>{ alert(res); runQuery(); }).updatePaymentStatus(ids, type, date);
      }
    }

    function voidOrder(serial) {
      if(confirm(`⚠️ 警告：您確定要作廢單號 [${serial}] 嗎？`)) {
        google.script.run.withSuccessHandler(res=>{ alert(res); runQuery(); }).voidInboundOrder(serial);
      }
    }

    function editDiscount(serial, currentVal) {
      const newVal = prompt(`請輸入單號 [${serial}] 新的折後總額：`, currentVal);
      
      // 如果使用者按取消或沒有輸入
      if (newVal === null) return;
      
      // 簡單的驗證
      if (newVal.trim() === '' || isNaN(newVal)) {
        alert("輸入錯誤：請輸入有效的數字金額！");
        return;
      }

      // 呼叫後端進行更新
      google.script.run.withSuccessHandler(function(res) {
        alert(res);
        runQuery(); // 更新成功後，重新執行查詢以刷新畫面
      }).updateOrderDiscount(serial, newVal);
    }

    function runAdminTask() {
      const pwd = prompt("請輸入管理員密碼：", "");
      if(pwd === null) return; 
      
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const d = String(now.getDate()).padStart(2, '0');
      const todayStr = `${y}${m}${d}`;
      
      const targetDate = prompt("請輸入要抹除資料的日期 (格式 YYYYMMDD)：", todayStr);
      if(targetDate === null) return;

      if(targetDate.length !== 8 || isNaN(targetDate)) {
        alert("格式錯誤！請輸入 8 碼數字，例如 20251215");
        return;
      }

      if(confirm(`⚠️ 嚴重警告 ⚠️\n\n此操作將「徹底刪除」日期為【${targetDate}】的所有單據資料！\n資料刪除後無法還原！\n\n確定要執行嗎？`)) {
        google.script.run.withSuccessHandler(res => {
          if(res.msg) alert(res.msg);
          else alert(res);
          if (res.nextSerial) {
            document.getElementById('manualSerial').value = res.nextSerial;
          }
          runQuery();
        }).adminDeleteDataByDate(pwd, targetDate);
      }
    }

    // === 新增 UI 控制：當勾選耗材群組時，停用單一藥品搜尋，避免衝突 ===
    function toggleStatInputs() {
      const isGroup = document.getElementById('statGroupZZ').checked;
      const drugInput = document.getElementById('statDrug');
      const vendorInput = document.getElementById('statVendor'); // 新增：抓取廠商欄位
      
      if (isGroup) {
        // 1. 鎖定並清空「指定藥品」
        drugInput.value = ''; 
        drugInput.disabled = true;
        drugInput.placeholder = "(已鎖定：群組統計)";
        drugInput.style.backgroundColor = "#eee";
        
        // 2. 鎖定並清空「指定廠商」
        vendorInput.value = ''; 
        vendorInput.disabled = true;
        vendorInput.placeholder = "(已鎖定：群組統計)";
        vendorInput.style.backgroundColor = "#eee";
        
      } else {
        // 1. 解除鎖定「指定藥品」
        drugInput.disabled = false;
        drugInput.placeholder = "選填...";
        drugInput.style.backgroundColor = "#fff";
        
        // 2. 解除鎖定「指定廠商」
        vendorInput.disabled = false;
        vendorInput.placeholder = "廠商...";
        vendorInput.style.backgroundColor = "#fff";
      }
    }

    // === 修改 runStats 傳送參數 ===
    function runStats() {
      const criteria = {
        startDate: document.getElementById('statStartDate').value,
        endDate: document.getElementById('statEndDate').value,
        vendor: document.getElementById('statVendor').value,
        drugCode: document.getElementById('statDrug').value,
        // 新增傳入參數：是否勾選耗材群組
        isConsumablesGroup: document.getElementById('statGroupZZ').checked
      };

      if(!criteria.startDate || !criteria.endDate) { alert("請選擇完整的日期區間"); return; }
      
      document.getElementById('statsResults').innerHTML = '<p align="center">統計運算中...</p>';
      google.script.run.withSuccessHandler(renderStatsTable).getStatisticsReport(criteria);
    }
    
    // 另外建議在 clearStatsForm 也加入重置 Checkbox
    function clearStatsForm() {
      // ... 原有代碼 ...
      document.getElementById('statVendor').value = '';
      document.getElementById('statDrug').value = '';
      
      // 新增重置
      document.getElementById('statGroupZZ').checked = false; 
      toggleStatInputs(); // 重置 UI 狀態
      
      document.getElementById('statsResults').innerHTML = '<p style="text-align:center; color:#888; padding:25px;">條件已清空</p>';
    }
  </script>
</body>
</html>
